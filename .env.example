# ==============================================================================
# Huseynovlar Terminal — Environment Configuration (.env.example)
# ==============================================================================
# Copy to /opt/huseynovlar-terminal/.env and fill in strong random secrets.

# --- Domain & WebAuthn / FIDO2 ---
TERMINAL_DOMAIN=terminal.huseynovlar.org
TERMINAL_ORIGIN=https://terminal.huseynovlar.org
WEBAUTHN_RP_ID=terminal.huseynovlar.org
WEBAUTHN_RP_NAME=Huseynovlar Terminal
DEFAULT_TIMEZONE=Asia/Baku

# --- Local Bind (proxied by existing Caddy inside NetBird VPN; 0 public ports) ---
FRONTEND_LOCAL_PORT=18443

# --- Security Secrets (generate via `openssl rand -hex 32`) ---
JWT_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
VAULT_MASTER_KEY=CHANGE_ME_FERNET_OR_32B_BASE64_KEY

# --- PostgreSQL ---
POSTGRES_DB=huseynovlar_terminal
POSTGRES_USER=terminal_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- Docker Container Ops Allowlist (separate MT5 compose containers) ---
MANAGED_CONTAINER_LABEL=exness-panel.managed=true
ALLOWED_MT5_CONTAINERS=

# --- Optional Integrations (can also be configured encrypted inside UI Settings) ---
GOOGLE_AI_API_KEY=
GOOGLE_AI_DEFAULT_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERTS_BOT_WEBHOOK_URL=http://127.0.0.1:18080/internal/webhooks/trading
ALERTS_BOT_WEBHOOK_SECRET=

# --- Backups (Google Drive restic compatible host directory; set on VPS deploy) ---
BACKUP_HOST_DIR=/var/backups/huseynovlar-terminal
BACKUP_RETENTION_DAYS=14
