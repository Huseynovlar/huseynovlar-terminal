# Add this site block to your existing Caddyfile inside NetBird VPN.
# Caddy automatically provisions and renews TLS for terminal.huseynovlar.org
# (required for FIDO2 / WebAuthn Passkeys).

terminal.huseynovlar.org {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    reverse_proxy 127.0.0.1:18443 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
