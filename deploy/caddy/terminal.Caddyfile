# Add this block to your Caddyfile on the VPS and reload Caddy.
# Also add internal DNS record in NetBird / internal DNS:
#   terminal.huseynovlar.org -> 100.104.116.58

terminal.huseynovlar.org {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	import security_headers

	@admins remote_ip 100.104.0.0/16

	handle @admins {
		reverse_proxy 127.0.0.1:18443
	}

	respond "Not Found" 404
}
