{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huseynovlar Terminal",
  "version": "2.0.0",
  "identifier": "com.huseynovlar.terminal",
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Huseynovlar Terminal",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "theme": "Dark",
        "backgroundColor": "#0B0E14",
        "titleBarStyle": "Overlay",
        "hiddenTitle": false,
        "decorations": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; img-src 'self' data: blob: https:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app", "nsis", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": { "width": 640, "height": 420 },
        "appPosition": { "x": 180, "y": 210 },
        "applicationFolderPosition": { "x": 460, "y": 210 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Huseynovlar Terminal"
      }
    },
    "linux": {
      "deb": {
        "section": "finance"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBLIC_KEY",
      "endpoints": [
        "https://api.huseynovlar.com/api/v1/pro/releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
